# Rendered by the nginx image's envsubst (only ${DEMO_*} is substituted, so
# nginx variables like $host survive).
#
# Two ports on the same host:
#   ${DEMO_APP_PORT}     the application, guarded by forward-auth
#   ${DEMO_PORTAL_PORT}  the login portal, served at / (its bundle uses
#                        absolute asset paths, so it cannot live under a prefix)

server {
  listen ${DEMO_PORTAL_PORT} ssl;
  server_name _;

  ssl_certificate     /etc/nginx/certs/demo.crt;
  ssl_certificate_key /etc/nginx/certs/demo.key;

  location / {
    proxy_pass http://authelia:9091;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
}

server {
  listen ${DEMO_APP_PORT} ssl;
  server_name _;

  ssl_certificate     /etc/nginx/certs/demo.crt;
  ssl_certificate_key /etc/nginx/certs/demo.key;

  location / {
    auth_request /internal/authz;
    auth_request_set $target_url $scheme://$http_host$request_uri;
    # Not authenticated: send the browser to the portal, then back here.
    error_page 401 =302 https://$host:${DEMO_PORTAL_PORT}/?rd=$target_url;
    error_page 403 =302 https://$host:${DEMO_PORTAL_PORT}/?rd=$target_url;

    # Authelia returns the verified identity in response headers; copy them
    # onto the upstream request. These names are what softwiki reads.
    auth_request_set $auth_user   $upstream_http_remote_user;
    auth_request_set $auth_groups $upstream_http_remote_groups;
    auth_request_set $auth_email  $upstream_http_remote_email;
    auth_request_set $auth_name   $upstream_http_remote_name;

    proxy_set_header X-Auth-Request-User   $auth_user;
    proxy_set_header X-Auth-Request-Groups $auth_groups;
    proxy_set_header X-Auth-Request-Email  $auth_email;
    proxy_set_header X-Auth-Request-Name   $auth_name;

    # Drop anything the client sent under the identity header names: the proxy
    # must be the only writer, otherwise a client could inject its own identity.
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Email "";
    proxy_set_header Remote-Name "";

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;

    proxy_pass http://softwiki:6200;
  }

  # Escape hatch: the built-in admin password login must NOT go through
  # forward-auth, otherwise it cannot be used when the identity provider is
  # down — which is the whole point of it. softwiki rate-limits and audits
  # these routes itself.
  location = /api/auth/password {
    proxy_pass http://softwiki:6200;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
  }

  # Read-only identity/diagnostics: same reasoning, and it lets the verification
  # tool report on a deployment whose provider is broken.
  location = /api/auth/me {
    proxy_pass http://softwiki:6200;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
  }

  location = /api/auth/providers {
    proxy_pass http://softwiki:6200;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location = /internal/authz {
    internal;
    proxy_pass http://authelia:9091/api/authz/forward-auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Forwarded-Method $request_method;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
}
