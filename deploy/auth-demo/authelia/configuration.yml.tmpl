# Authelia configuration for the forward-auth demo.
# Secrets are injected by setup.sh into configuration.yml from this template.

theme: light

server:
  address: 'tcp://:9091'
  endpoints:
    authz:
      forward-auth:
        # AuthRequest returns 401 for "not authenticated", which nginx
        # converts into a redirect to the portal. ForwardAuth returns 302,
        # which nginx's auth_request rejects as an unexpected status.
        implementation: 'AuthRequest'

log:
  level: 'info'

identity_validation:
  reset_password:
    jwt_secret: '__JWT_SECRET__'

authentication_backend:
  file:
    path: '/config/users.yml'

# Everyone who can log in may use the app; fine-grained roles live in softwiki.
access_control:
  default_policy: 'one_factor'

session:
  secret: '__SESSION_SECRET__'
  expiration: '1h'
  cookies:
    - domain: '127.0.0.1'
      authelia_url: 'https://127.0.0.1:6191'
      default_redirection_url: 'https://127.0.0.1:6190'

storage:
  encryption_key: '__STORAGE_KEY__'
  local:
    path: '/config/db.sqlite3'

notifier:
  filesystem:
    filename: '/config/notifications.txt'
