[Unit]
Description=softwiki CI deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=faye
WorkingDirectory=/home/faye/softwiki-ci
Environment=SOFTWIKI_ENV_FILE=/opt/aitools/apps/softwiki/.env
Environment=SOFTWIKI_WORKSPACE=/opt/aitools/apps/softwiki/workspace
Environment=SOFTWIKI_ACTIVE_WORKSPACE=lsl-kb
Environment=API_HOST_PORT=6300
Environment=MCP_HOST_PORT=6301
Environment=WEB_HOST_PORT=6308
ExecStart=/home/faye/softwiki-ci/scripts/ci-deploy.sh
TimeoutStartSec=1800
